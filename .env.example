APP_ORIGIN=http://localhost:3000
PORT=3000
# Set a Postgres URL for durable live runs. Without it the app is read-only.
DATABASE_URL=
OPENROUTER_API_KEY=
WORKER_MODEL=nvidia/nemotron-3.5-lightning:free
REVIEWER_MODEL=nvidia/nemotron-3.5-lightning:free
OPERATOR_WALLET_ADDRESS=
WORKER_PAYOUT_ADDRESS=
REVIEWER_PAYOUT_ADDRESS=
SOLANA_RPC_URL=https://api.devnet.solana.com
PROGRAM_ID=
# Browser RPC must be public; never place a secret RPC credential here.
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
