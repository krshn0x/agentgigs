{
  "name": "orbit-tasks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env src/server.mjs",
    "web:dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "preflight": "node --env-file-if-exists=.env scripts/preflight.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "playwright test",
    "program:build": "NO_DNA=1 anchor build",
    "client:generate": "node scripts/generate-client.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs"
  },
  "dependencies": {
    "@solana/kit": "8.6.0",
    "@solana/kit-plugin-rpc": "0.23.0",
    "@solana/kit-plugin-wallet": "0.23.0",
    "@solana/react": "8.6.0",
    "pg": "^8.16.3",
    "quickjs-emscripten": "^0.31.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "1.5.6",
    "@codama/renderers-js": "2.8.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "codama": "^1.0.0",
    "embedded-postgres": "^18.6.0-beta.19",
    "litesvm": "1.6.2",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
